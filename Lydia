import requests

def fetch_layer(service_url, layer_id, where="1=1", page_size=1000):
    url = f"{service_url}/{layer_id}/query"
    frames, offset = [], 0
    while True:
        params = {
            "where": where,
            "outFields": "*",
            "outSR": 4326,            # WGS84 lat/lon
            "f": "geojson",
            "resultOffset": offset,
            "resultRecordCount": page_size,
        }
        r = requests.get(url, params=params, timeout=60)
        r.raise_for_status()
        gdf = gpd.GeoDataFrame.from_features(r.json()["features"], crs="EPSG:4326")
        if gdf.empty:
            break
        frames.append(gdf)
        if len(gdf) < page_size:
            break
        offset += page_size
    return gpd.pd.concat(frames, ignore_index=True) if frames else gpd.GeoDataFrame()

