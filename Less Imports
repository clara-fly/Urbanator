import io, math                                                        # standard library: in-memory bytes, math
import numpy as np                                                     # grid math
import requests                                                        # talks to the ArcGIS servers
import matplotlib.pyplot as plt                                        # map, popup tables, and reading the NLCD image
from matplotlib.path import Path                                       # point-in-polygon test (part of matplotlib)

# ---------------- SETTINGS ----------------
WEST, EAST, SOUTH, NORTH = -109.0603, -102.0415, 36.9925, 41.0034      # Colorado treated as a box
LAT_MID = (SOUTH + NORTH) / 2                                          # middle latitude, used to size squares
DLAT = 1 / 111.32                                                      # 1 km in degrees of latitude
DLON = 1 / (111.32 * math.cos(math.radians(LAT_MID)))                  # 1 km in degrees of longitude
NX, NY = math.ceil((EAST - WEST) / DLON), math.ceil((NORTH - SOUTH) / DLAT)  # number of columns, rows
XS = WEST + (np.arange(NX) + 0.5) * DLON                               # longitude of each square's center
YS = NORTH - (np.arange(NY) + 0.5) * DLAT                              # latitude of each square's center (north -> south)
SPECIES_URL = "https://services5.arcgis.com/ttNGmDvKQA7oeDQ3/arcgis/rest/services/CPWSpeciesData/FeatureServer"  # CPW species
PADUS_URL = "https://services.arcgis.com/v01gqwM5QqNysAAi/ArcGIS/rest/services/PADUS3_0FederalFeeManagers_Authoritative/FeatureServer/0"  # protected land
NLCD_URL = "https://di-nlcd.img.arcgis.com/arcgis/rest/services/USA_NLCD_Annual_LandCover/ImageServer"  # land cover
PRIORITY = ["Overall Range", "Breeding Range", "HUC 12 Presence"]      # species layer preference, best first
DEV_CLASSES = (22, 23, 24)                                             # NLCD low/medium/high intensity developed
DEV_THRESHOLD = 0.25                                                   # square is "developed" if >=25% built
DECAY_KM, MAX_KM = 5.0, 20                                             # weight = e^(-d/5), ignore beyond 20 km
SUB = 5                                                                # NLCD samples per km (~200 m spacing)
PADUS_FIELDS = ["Own_Name", "Own_Type", "Mang_Name", "Unit_Nm", "Des_Tp"]  # protected-land details we keep
GREEN = (0.12, 0.48, 0.2)                                              # protected-land color (RGB)

# ---------------- DOWNLOAD HELPERS (kept in memory, nothing saved to disk) ----------------
def get_json(url, params):                                             # GET a URL and return its JSON
    r = requests.get(url, params=params, timeout=180)                  # send request
    r.raise_for_status()                                               # stop on HTTP errors
    data = r.json()                                                    # parse JSON
    if "error" in data: raise RuntimeError(data["error"])              # stop on ArcGIS errors
    return data                                                        # hand back the result

def query_features(layer_url, fields=""):                              # download all polygons in the Colorado box
    params = {"where": "1=1", "geometry": f"{WEST},{SOUTH},{EAST},{NORTH}",  # everything inside the box
              "geometryType": "esriGeometryEnvelope", "inSR": 4326, "outSR": 4326,  # box and output in lat/lon
              "outFields": fields, "maxAllowableOffset": 0.003,        # attributes wanted; simplify shapes ~300 m
              "resultRecordCount": 2000, "f": "geojson"}               # 2000 per page, GeoJSON format
    feats, offset = [], 0                                              # results list, page position
    while True:                                                        # keep paging until done
        params["resultOffset"] = offset                                # which page to get
        data = get_json(f"{layer_url}/query", params)                  # fetch page
        batch = data.get("features") or []                             # features on this page
        feats += batch                                                 # add to results
        more = data.get("exceededTransferLimit") or (data.get("properties") or {}).get("exceededTransferLimit")  # server says more exist?
        if not batch or (len(batch) < 2000 and not more): return feats  # last page reached
        offset += len(batch)                                           # move to next page

def span(pts):                                                         # grid rows/cols covered by a set of points
    c0, c1 = np.searchsorted(XS, [pts[:, 0].min(), pts[:, 0].max()])   # first/last column inside
    r0, r1 = np.searchsorted(-YS, [-pts[:, 1].max(), -pts[:, 1].min()])  # first/last row inside
    return r0, r1, c0, c1                                              # row and column range

def burn(feats, numbered=False):                                       # paint polygons onto the 1 km grid
    out = np.full((NY, NX), -1) if numbered else np.zeros((NY, NX), bool)  # polygon number per square, or yes/no
    for i, f in enumerate(feats):                                      # each polygon feature
        g = f.get("geometry") or {}                                    # its shape
        polys = {"Polygon": [g.get("coordinates")], "MultiPolygon": g.get("coordinates")}.get(g.get("type")) or []  # list of polygons
        rings = [np.asarray(r) for p in polys for r in p if len(r) > 2]  # outer edges + holes
        if not rings: continue                                         # nothing to draw
        R0, R1, C0, C1 = span(np.vstack(rings))                        # feature's grid window
        if R0 >= R1 or C0 >= C1: continue                              # too small / outside grid
        inside = np.zeros((R1 - R0, C1 - C0), bool)                    # local yes/no window
        for ring in rings:                                             # each ring
            r0, r1, c0, c1 = span(ring)                                # ring's own window
            if r0 >= r1 or c0 >= c1: continue                          # skip tiny rings
            gx, gy = np.meshgrid(XS[c0:c1], YS[r0:r1])                 # square centers in that window
            hit = Path(ring).contains_points(np.c_[gx.ravel(), gy.ravel()]).reshape(gx.shape)  # centers inside ring
            inside[r0 - R0:r1 - R0, c0 - C0:c1 - C0] ^= hit            # flip = holes cancel out correctly
        if numbered: out[R0:R1, C0:C1][inside] = i                     # store polygon number
        else: out[R0:R1, C0:C1] |= inside                              # mark as present
    return out                                                         # finished grid

# ---------------- LOAD DATA ----------------
def load_species():                                                    # one yes/no grid per species
    options = {}                                                       # species -> {priority: (layer id, type)}
    for lyr in get_json(SPECIES_URL, {"f": "json"})["layers"]:         # every layer in the service
        name = " ".join(lyr["name"].split())                           # tidy double spaces
        if "historic" in name.lower(): continue                        # skip historic layers
        for p, suffix in enumerate(PRIORITY):                          # check each allowed layer type
            if name.endswith(suffix):                                  # layer matches this type
                options.setdefault(name[:-len(suffix)].strip(), {})[p] = (lyr["id"], suffix)  # group by species name
                break                                                  # stop checking types
    names, masks = [], []                                              # species labels and grids
    for i, (sp, o) in enumerate(sorted(options.items()), 1):           # each species, alphabetical
        lid, suffix = o[min(o)]                                        # best-priority layer for it
        print(f"  [{i}/{len(options)}] {sp} {suffix}", flush=True)     # progress message
        try: masks.append(burn(query_features(f"{SPECIES_URL}/{lid}")))  # download and grid it
        except Exception as e: print(f"    skipped ({e})"); continue  # skip a failed layer
        names.append(sp + ("" if suffix == "Overall Range" else f" ({suffix})"))  # label, noting non-overall layers
    return names, np.stack(masks)                                      # list + 3D array [species, row, col]

def load_protected():                                                  # protected-land grid + owner details
    info = get_json(PADUS_URL, {"f": "json"})                          # layer description
    codes = {f["name"]: {str(c["code"]): c["name"] for c in f["domain"]["codedValues"]}  # code -> full name (e.g. BLM)
             for f in info["fields"] if (f.get("domain") or {}).get("codedValues")}  # only fields that use codes
    feats = query_features(PADUS_URL, ",".join(PADUS_FIELDS))         # download polygons + fields
    attrs = [{k: codes.get(k, {}).get(str(v), str(v)) if v is not None else "-"  # decode each field
              for k, v in ((k, (f.get("properties") or {}).get(k)) for k in PADUS_FIELDS)} for f in feats]  # per polygon
    return burn(feats, numbered=True), attrs                           # grid of polygon numbers + details

def load_developed():                                                  # fraction of each square already built
    t_end = get_json(NLCD_URL, {"f": "json"})["timeInfo"]["timeExtent"][1]  # newest NLCD year available
    frac, T = np.zeros((NY, NX)), 150                                  # result grid, tile size in squares
    tiles = [(r, c) for r in range(0, NY, T) for c in range(0, NX, T)]  # split state into tiles
    for k, (r0, c0) in enumerate(tiles, 1):                            # each tile
        r1, c1 = min(r0 + T, NY), min(c0 + T, NX)                      # tile end row/col
        print(f"  NLCD tile {k}/{len(tiles)}", flush=True)             # progress message
        p = {"bbox": f"{WEST + c0*DLON},{NORTH - r1*DLAT},{WEST + c1*DLON},{NORTH - r0*DLAT}",  # tile box
             "bboxSR": 4326, "imageSR": 4326, "size": f"{(c1-c0)*SUB},{(r1-r0)*SUB}",  # lat/lon, pixel size
             "format": "tiff", "pixelType": "U8", "interpolation": "RSP_NearestNeighbor",  # raw class codes
             "time": t_end, "f": "image"}                              # newest year, return image bytes
        r = requests.get(f"{NLCD_URL}/exportImage", params=p, timeout=300); r.raise_for_status()  # download tile
        a = plt.imread(io.BytesIO(r.content), format="tiff")          # read image in memory (no file saved)
        a = a[..., 0] if a.ndim == 3 else a                            # keep one band
        h, w = (r1 - r0) * SUB, (c1 - c0) * SUB                        # expected size
        a = a[np.ix_(np.arange(h) * a.shape[0] // h, np.arange(w) * a.shape[1] // w)]  # force exact size
        frac[r0:r1, c0:c1] = np.isin(a, DEV_CLASSES).reshape(r1-r0, SUB, c1-c0, SUB).mean((1, 3))  # % developed per square
    return frac                                                        # developed fraction grid

# ---------------- SCORING ----------------
def convolve(a, k):                                                    # sum of k-weighted neighbors (via FFT, fast)
    s = (a.shape[0] + k.shape[0] - 1, a.shape[1] + k.shape[1] - 1)     # padded size
    out = np.fft.irfft2(np.fft.rfft2(a, s) * np.fft.rfft2(k, s), s)    # multiply in frequency space
    h = k.shape[0] // 2                                                # kernel radius
    return np.clip(out[h:h + a.shape[0], h:h + a.shape[1]], 0, None)   # crop back to grid, remove tiny negatives

def compute(stack, dev_frac):                                          # build all score grids
    count = stack.sum(0)                                               # species per square
    developed = (dev_frac >= DEV_THRESHOLD).astype(float)              # 1 = developed square
    y, x = np.mgrid[-MAX_KM:MAX_KM + 1, -MAX_KM:MAX_KM + 1]            # offsets within 20 km
    d = np.hypot(x, y)                                                 # distance in km
    near = convolve(developed, np.where(d <= MAX_KM, np.exp(-d / DECAY_KM), 0))  # e^(-d/5) weighted, 0 past 20 km
    ref = np.percentile(near[near > 1e-9], 99) if (near > 1e-9).any() else 1  # 99th percentile as "fully urban"
    sp_part = 50 * count / max(count.max(), 1)                         # species half: more species = higher
    px_part = 50 * (1 - np.clip(near / ref, 0, 1))                     # proximity half: less nearby = higher
    return dict(sp=sp_part, px=px_part, near=near, score=sp_part + px_part)  # bundle results

# ---------------- POPUP TABLE ----------------
def show_info(D, lat, lon, block=True):                                # popup for one square
    if not (WEST <= lon <= EAST and SOUTH <= lat <= NORTH): return print("  Outside Colorado box.")  # bounds check
    r, c = min(int((NORTH - lat) / DLAT), NY - 1), min(int((lon - WEST) / DLON), NX - 1)  # find the square
    idx = D["pidx"][r, c]                                              # protected polygon number (-1 = none)
    species = [D["names"][k] for k in np.flatnonzero(D["stack"][:, r, c])]  # species in this square
    score = D["score"][r, c]                                           # urbanization score
    rows = [["Coordinates", f"{lat:.5f}, {lon:.5f}"], ["Grid square (row, col)", f"{r}, {c}"]]  # basic info
    if idx >= 0:                                                       # protected land
        a = D["pattrs"][idx]                                           # its details
        rows += [["Status", "PROTECTED - building NOT allowed"], ["Owner", a["Own_Name"]],  # status + owner
                 ["Owner type", a["Own_Type"]], ["Manager", a["Mang_Name"]], ["Area name", a["Unit_Nm"]],  # more details
                 ["Designation", a["Des_Tp"]], ["Urbanization score", f"NOT ALLOWED (raw {score:.1f})"]]  # score blocked
    else: rows += [["Status", "Not protected"], ["Urbanization score", f"{score:.1f} / 100"]]  # buildable
    rows += [["  Species half (0-50)", f"{D['sp'][r, c]:.1f}  ({len(species)} species)"],  # species part
             ["  Proximity half (0-50)", f"{D['px'][r, c]:.1f}  (weighted nearby dev. {D['near'][r, c]:.2f})"],  # proximity part
             ["Square already developed", f"{D['dev'][r, c] * 100:.0f}%"]]  # how built-up it is now
    sp = species or ["None recorded"]                                  # species list (or placeholder)
    n = math.ceil(len(sp) / 3)                                         # rows needed for 3 columns
    grid = [[sp[j * n + i] if j * n + i < len(sp) else "" for j in range(3)] for i in range(n)]  # 3-column layout
    fig, (a1, a2) = plt.subplots(2, 1, figsize=(11, 3 + 0.3 * (len(rows) + n)),  # two stacked tables
                                 gridspec_kw={"height_ratios": [len(rows) + 1, n + 1]})  # sized to content
    for ax in (a1, a2): ax.axis("off")                                 # hide axes
    t1 = a1.table(cellText=rows, colLabels=["Item", "Value"], colWidths=[0.3, 0.7], cellLoc="left", loc="upper center")  # info table
    t2 = a2.table(cellText=grid, cellLoc="left", loc="upper center")   # species table
    for t in (t1, t2): t.auto_set_font_size(False); t.set_fontsize(9); t.scale(1, 1.3)  # readable text
    a1.set_title("Urbanization assessment", loc="left", fontweight="bold")  # top title
    a2.set_title(f"Species in this square ({len(species)})", loc="left", fontweight="bold")  # bottom title
    fig.tight_layout()                                                 # tidy spacing
    plt.show() if block else fig.show()                                # wait, or open alongside the map

# ---------------- MAP ----------------
def show_map(D):                                                       # statewide map
    fig, ax = plt.subplots(figsize=(13, 8.5))                          # window size
    gray = 1 - D["score"] / 100                                        # score -> brightness (0 = white, 100 = black)
    img = np.dstack([gray, gray, gray])                                # grayscale as an RGB picture
    img[D["pidx"] >= 0] = GREEN                                        # protected squares solid green
    ax.imshow(img, extent=[WEST, WEST + NX * DLON, NORTH - NY * DLAT, NORTH], interpolation="nearest")  # draw it
    ax.set_xlim(WEST, EAST); ax.set_ylim(SOUTH, NORTH)                 # trim to the box
    ax.set_aspect(1 / math.cos(math.radians(LAT_MID)))                 # keep squares looking square
    ax.set_title("Colorado urbanization score (click a square for details)")  # title
    ax.set_xlabel("Longitude"); ax.set_ylabel("Latitude")              # axis labels
    scale = plt.cm.ScalarMappable(cmap="Greys", norm=plt.Normalize(0, 100))  # 0-100 gray scale for the legend
    fig.colorbar(scale, ax=ax, fraction=0.03).set_label("Score: 0 = white (low danger), 100 = black (high danger)")  # scale legend
    ax.plot([], [], "s", color=GREEN, markersize=12, label="Protected land - no building")  # green legend entry
    ax.legend(loc="upper center", bbox_to_anchor=(0.5, -0.07))        # show it under the map
    def click(e):                                                      # runs when you click the map
        tb = getattr(fig.canvas, "toolbar", None)                      # zoom/pan toolbar
        if e.inaxes is ax and e.button == 1 and not (tb and tb.mode): show_info(D, e.ydata, e.xdata, block=False)  # left-click = popup
    fig.canvas.mpl_connect("button_press_event", click)                # hook up clicks
    plt.show()                                                         # display until closed

# ---------------- MAIN ----------------
def main():                                                            # program start
    print("Loading species..."); names, stack = load_species()         # CPW data
    print("Loading protected land..."); pidx, pattrs = load_protected()  # PAD-US data
    print("Loading developed land..."); dev = load_developed()         # NLCD data
    D = dict(names=names, stack=stack, pidx=pidx, pattrs=pattrs, dev=dev, **compute(stack, dev))  # everything in one dict
    print(f"Ready: {NX} x {NY} squares, {len(names)} species.")       # done loading
    while True:                                                        # menu loop
        ch = input("\n1 = look up coordinates, 2 = show map, q = quit: ").strip().lower()  # ask user
        if ch == "1":                                                  # coordinate lookup
            try: lat, lon = map(float, input("lat, lon (e.g. 39.7555, -105.2211): ").replace(",", " ").split())  # read numbers
            except ValueError: print("  Enter two numbers."); continue  # bad input
            show_info(D, lat, lon)                                     # popup table
        elif ch == "2": show_map(D)                                    # map
        elif ch == "q": break                                          # exit

if __name__ == "__main__": main()                                      # run when started directly
